# environments
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# data: CompCars images and any path table are never committed
data/external/
data/paths/
data/masks/
*.parquet
!data/manifests/**/*.parquet
!data/splits/**/*.parquet
!tests/fixtures/**/*.parquet
*.pkl
*.npy
*.safetensors

# experiment tracking
mlruns/
outputs/
.dvc/cache/

# scratch
.scratch/
.env

# editor and tool state: every top-level dot-folder except the CI workflows
/.*/
!/.github/
!/.dvc/
/*-lock.json

# dedup audit panels are CompCars pixels; the pair list is committed as CSV instead
reports/dedup/pairs/

# derived embeddings (resumable per-shard store, PROTOCOL.md §9)
data/embeddings/

# M1 gate outputs: persisted prototypes and the embedded Qdrant store (sha256 sidecars are committed)
data/qdrant/

# Qdrant server storage mounted by docker/docker-compose.yml (M5-1)
data/qdrant_server/

# demo screenshots contain CompCars pixels; never committed (docs/protocols/compcars-licence.md)
reports/figures/demo/*.png
